{
  "entryPoints": ["./src/index.ts"],
  "customCss": "./typedoc/typedoc.css",
  "groupOrder": [
    "Model Classes",
    "Data Transfer Objects",
    "Document-store Objects",
    "Filter Objects",
    "Utilities",
    "Constructing this model",
    "Methods",
    "Accessors",
    "Properties",
    "*"
  ],
  "categoryOrder": [
    "Persistent",
    "Embedded",
    "Interfaces",
    "Types",
    "Functions",
    "*"
  ],
  "categorizeByGroup": true,
  "navigation": {
    "includeGroups": true,
    "includeCategories": true
  },
  "sort": ["required-first", "alphabetical"],
  "plugin": ["./typedoc/plugins/typedoc-link-map.mts"],
  "router": "kind-dir",
  "navigationLinks": {
    "Hatsuboshi App Docs": "https://docs.hatsuboshi.app",
    "GitHub": "https://github.com/hatsuboshi-app/types"
  },
  "hostedBaseUrl": "https://docs.hatsuboshi.app"
}